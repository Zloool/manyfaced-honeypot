# manyfaced honeypot configuration
# Environment variables (HONEY_* prefix) control all settings.
# Copy to /opt/manyfaced/honeypot.env and adjust values.

# ── Client honeypot ──────────────────────────────────────────────────────────
# Port to impersonate services on (single mode)
HONEY_HONEYPORT=8080

# Port mode: single, top, all
HONEY_PORT_MODE=top

# Custom top ports (comma-separated, overrides hardcoded list)
# Format: high ports that the honeypot binds to for privileged port coverage
# Privileged ports (<1024) are redirected via iptables to these high ports
HONEY_TOP_PORTS=8080,8443,1433,1521,2049,3306,3389,4369,5000,5432,5672,5900,5901,6379,7001,7002,8888,9090,9200,10021,10022,10023,10025,10053,10110,10135,10139,10143,10445,10993,10995,11211,11300,11301,11302,11303,11304,11305,11306,11307,11308,11309,11310,11311,15672,2181,27017

# ── Hive (server) settings ───────────────────────────────────────────────────
HONEY_HIVEHOST=127.0.0.1
HONEY_HIVEPORT=8888
HONEY_HIVELOGIN=DO-HP-DOHP
HONEY_HIVEPASS=change_this_to_a_random_string

# ── Database ─────────────────────────────────────────────────────────────────
HONEY_DB_BACKEND=sqlite
HONEY_DB_PATH=/opt/manyfaced/bots/honeypot.sqlite

# ── Logging ──────────────────────────────────────────────────────────────────
HONEY_LOG_FILE=/opt/manyfaced/bots/honeypot.log

# ── Status timeouts ──────────────────────────────────────────────────────────
HONEY_HIVESTATUSTIMEOUT=30
HONEY_HONEYSTATUSTIMEOUT=30

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of authorized bear identifiers (empty = accept all)
HONEY_AUTHORIZED_BEES=""  # semicolon-separated "bee_id:key" pairs for authorized client sensors
