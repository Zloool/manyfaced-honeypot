[Unit]
Description=Manyfaced Honeypot - Multi-faced honeypot for detecting bot activity
Documentation=https://github.com/Zloool/manyfaced-honeypot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=honeypot
Group=honeypot
WorkingDirectory=/opt/manyfaced
EnvironmentFile=/opt/manyfaced/honeypot.env
ExecStart=/opt/manyfaced/venv/bin/python3 -m manyfaced.mfh
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/manyfaced/bots /home/honeypot/.config

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=manyfaced

[Install]
WantedBy=multi-user.target
