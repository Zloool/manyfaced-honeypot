# manyfaced honeypot configuration
# Copy this to /opt/manyfaced/honeypot.env and edit as needed.
# Environment variables (HONEY_* prefix) control all settings.
#
# Usage:
#   sudo cp systemd/honeypot.env.example /opt/manyfaced/honeypot.env
#   sudo chmod 600 /opt/manyfaced/honeypot.env  # restrict access
#   sudo systemctl restart manyfaced

# Client — port to impersonate services on
# Standard HTTP port (80) is ideal but requires root. Use 8080+ for non-root.
HONEY_HONEYPORT=8080

# Client — port mode: single, top, all
#   single  – listen on one port (HONEYPORT)
#   top     – listen on the top 50 most-scanned ports
#   all     – listen on all 65535 TCP ports
HONEY_PORT_MODE=top

# Server (hive) settings — receives encrypted reports from client
HONEY_HIVEHOST=127.0.0.1
HONEY_HIVEPORT=8888
# Unique identifier for this honeypot instance
HONEY_HIVELOGIN=YOUR-HOSTNAME
# AES encryption key (32 hex bytes = 256-bit key)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HONEY_HIVEPASS=CHANGE-ME-GENERATE-NEW-KEY

# Database backend: sqlite or postgresql
HONEY_DB_BACKEND=sqlite
HONEY_DB_PATH=/opt/manyfaced/bots/honeypot.sqlite

# Logging
HONEY_LOG_FILE=/opt/manyfaced/bots/honeypot.log

# Security — semicolon-separated "bear_id:key" pairs for authorized bots
HONEY_AUTHORISEDBEARS=""
