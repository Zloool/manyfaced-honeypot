# manyfaced configuration file
# Copy this to ~/.config/manyfaced/config.toml and edit as needed.
# Environment variables (prefix HONEY_) always take precedence.

[honeypot]
honeyport = 80
honeyfolder = "bots"

[hive]
hivehost = "127.0.0.1"
hiveport = 8080
hivelogin = "honeybee"
hivepass = "beehive123"

[database]
backend = "sqlite"
backends = ["sqlite", "postgresql"]
path = "bots/honeypot.db"
pg_host = "localhost"
pg_port = 5432
pg_db = "honeypot"
pg_user = "postgres"
pg_password = "postgres"

[security]
# semicolon-separated bearid:key pairs for authorized bots
# e.g. "bear1:key1;bear2:key2"
authorised_bears = ""
