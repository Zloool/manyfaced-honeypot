# manyfaced configuration file
# Copy this to ~/.config/manyfaced/config.toml and edit as needed.
# Environment variables (prefix HONEY_) always take precedence.

[honeypot]
honeyport = 80
honeyfolder = "bots"
# Port listening mode: "single" (one port), "top" (top 50 scanned ports), "all" (all 65535 ports)
port_mode = "single"
# Comma-separated list of ports to listen on when port_mode=top (empty = use default top 50)
top_ports = ""

[hive]
hivehost = "127.0.0.1"
hiveport = 8080
hivelogin = "honeybee"
hivepass = "beehive123"

[database]
backend = "sqlite"
backends = ["sqlite", "postgresql"]
path = "bots/honeypot.db"
pg_host = "localhost"
pg_port = 5432
pg_db = "honeypot"
pg_user = "postgres"
pg_password = "postgres"

[security]
# semicolon-separated bearid:key pairs for authorized bots
# e.g. "bear1:key1;bear2:key2"
authorized_beans = ""  # semicolon-separated "bean_id:key" pairs for client sensors

[logging]
# Path to the log file (JSON format). Falls back to ~/.local/share/manyfaced/honeypot.log
file = "/opt/manyfaced/bots/honeypot.log"
