"""
File, to store some multi-run parameters
`HONEYFOLDER` - root folder, to put all gathered data into.
Edit this file to set your honeypot configuration.

Database configuration:
  The honeypot supports two database backends: 'sqlite' (default) or 'postgresql'.
  Set DB_BACKEND to switch between them. SQLite stores all data in a single file
  (configured via DB_PATH). For PostgreSQL, configure the DB_PG_* settings below.
"""

HONEYPORT = 80
HONEYFOLDER = "bots"
HIVEHOST = "127.0.0.1"
HIVEPORT = 666
HIVELOGIN = "CHORDCOLLISION"
HIVEPASS = "test"
AUTHORISEDBEARS = {"CHOR...ON": "test"}

# Database backend: 'sqlite' (default) or 'postgresql'
DB_BACKEND = "sqlite"
DB_BACKENDS = ("sqlite", "postgresql")

# SQLite settings
DB_PATH = "bots/honeypot.db"

# PostgreSQL settings
DB_PG_HOST = "localhost"
DB_PG_PORT = 5432
DB_PG_DB = "honeypot"
DB_PG_USER = "postgres"
DB_PG_PASSWORD = "postgres"
