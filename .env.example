# Environment variables for manyfaced honeypot
# Copy to .env and fill in values
# Generate a new key with: python3 -c "import secrets; print(secrets.token_hex(32))"

# Client honeypot port (external)
HONEY_PORT=8080

# Server honeypot port (external)
HIVE_PORT=8888

# Server authentication
HONEY_HIVELOGIN=manyfaced
HONEY_HIVEPASS=CHANGE-ME-GENERATE-NEW-KEY
