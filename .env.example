# Environment variables for manyfaced honeypot
# Copy to .env and fill in values, or export directly in your shell.
# All env vars use the HONEY_ prefix (e.g. HONEY_HONEYPORT).
# Generate a new key with: python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Client honeypot (external-facing) ────────────────────────────────────────
HONEY_HONEYPORT=80
HONEY_HONEYFOLDER=bots
# Port listening mode: "single", "top", or "all"
HONEY_HONEY_PORT_MODE=single
# Comma-separated ports for top mode (empty = use default top 50)
HONEY_HONEY_TOP_PORTS=

# ── Server honeypot (internal communication) ─────────────────────────────────
HONEY_HIVEHOST=127.0.0.1
HONEY_HIVEPORT=8080
HONEY_HIVELOGIN=honeybee
# MUST be set — shared encryption key for bot reports
HONEY_HIVEPASS=CHANGE-ME-GENERATE-NEW-KEY

# ── Database ─────────────────────────────────────────────────────────────────
HONEY_DB_BACKEND=sqlite
HONEY_DB_PATH=bots/honeypot.db
# PostgreSQL settings (used when backend=postgresql)
HONEY_DB_PG_HOST=localhost
HONEY_DB_PG_PORT=5432
HONEY_DB_PG_DB=honeypot
HONEY_DB_PG_USER=postgres
HONEY_DB_PG_PASSWORD=***

# ── Security ─────────────────────────────────────────────────────────────────
# semicolon-separated "bee_id:key" pairs for authorized client sensors
HONEY_AUTHORIZED_BEES=
# Default encryption key for unknown identifiers — MUST be set before starting
HONEY_DEFAULT_KEY=CHANGE-ME-GENERATE-NEW-KEY

# ── Logging ──────────────────────────────────────────────────────────────────
HONEY_LOG_FILE=~/.local/share/manyfaced/honeypot.log

# ── Dump file (fallback for failed DB writes) ────────────────────────────────
HONEY_DUMP_FILE=dump.jsonl

# ── Lockfile (prevents multiple instances) ───────────────────────────────────
HONEY_LOCKFILE=/opt/manyfaced/bots/lockfile
